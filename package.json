{
  "name": "karel-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,json,md,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yaml}\"",
    "dev:core": "pnpm --filter @karel/core dev",
    "dev:web": "pnpm --filter @karel/web dev",
    "watch:ext": "pnpm --filter vs-karel watch"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
