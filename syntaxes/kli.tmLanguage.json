{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Karel Instructions",
  "patterns": [
    { "include": "#comments" },
    { "include": "#program-structure" },
    { "include": "#control-flow" },
    { "include": "#conditions" },
    { "include": "#instructions" },
    { "include": "#numbers" },
    { "include": "#custom-instruction-def" },
    { "include": "#custom-instruction-call" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.karel",
          "match": "//.*$"
        }
      ]
    },
    "program-structure": {
      "patterns": [
        {
          "name": "keyword.control.program.karel",
          "match": "(?i)(?<![\\w-])(BEGINNING-OF-PROGRAM|END-OF-PROGRAM|BEGINNING-OF-EXECUTION|END-OF-EXECUTION)(?![\\w-])"
        },
        {
          "name": "keyword.control.block.karel",
          "match": "(?i)(?<![\\w-])(BEGIN|END)(?![\\w-])"
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.conditional.karel",
          "match": "(?i)(?<![\\w-])(IF|THEN|ELSE)(?![\\w-])"
        },
        {
          "name": "keyword.control.loop.karel",
          "match": "(?i)(?<![\\w-])(WHILE|DO|ITERATE|TIMES)(?![\\w-])"
        }
      ]
    },
    "conditions": {
      "patterns": [
        {
          "name": "support.function.condition.karel",
          "match": "(?i)(?<![\\w-])(front-is-clear|front-is-blocked|left-is-clear|left-is-blocked|right-is-clear|right-is-blocked|next-to-a-beeper|not-next-to-a-beeper|facing-north|not-facing-north|facing-south|not-facing-south|facing-east|not-facing-east|facing-west|not-facing-west|beeper-in-bag|no-beeper-in-bag)(?![\\w-])"
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "name": "support.function.builtin.karel",
          "match": "(?i)(?<![\\w-])(move|turnleft|pickbeeper|putbeeper|turnoff)(?![\\w-])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.karel",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "custom-instruction-def": {
      "patterns": [
        {
          "match": "(?i)(?<![\\w-])(DEFINE-NEW-INSTRUCTION)\\s+([a-zA-Z][a-zA-Z0-9-]*)\\s+(AS)(?![\\w-])",
          "captures": {
            "1": { "name": "keyword.other.define.karel" },
            "2": { "name": "entity.name.function.karel" },
            "3": { "name": "keyword.other.as.karel" }
          }
        }
      ]
    },
    "custom-instruction-call": {
      "patterns": [
        {
          "name": "entity.name.function.call.karel",
          "match": "(?<![\\w-])[a-zA-Z][a-zA-Z0-9-]*(?![\\w-])(?=\\s*(;|$))"
        }
      ]
    }
  },
  "scopeName": "source.karel"
}
