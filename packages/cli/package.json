{
  "name": "@karel/cli",
  "version": "0.1.0",
  "description": "Run and grade Karel programs from the command line.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "karel": "./dist/karel.mjs"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GH-Jaider/karel",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/karel.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@karel/core": "workspace:*",
    "@types/node": "22.x",
    "esbuild": "^0.27.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
