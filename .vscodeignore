# VS Code Extension Package Ignores
# Excludes files not needed in the production VSIX

# Source files (bundled into dist/)
src/
tsconfig.json
webpack.config.js
out/

# Development config
eslint.config.mjs
.prettierrc
.prettierignore
.vscode/

# Git
.git/
.gitignore
.github/

# Package manager
node_modules/
pnpm-lock.yaml
package-lock.json
yarn.lock

# Build artifacts
dist/**/*.map
*.map
.vscode-test/
